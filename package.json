{
  "name": "dsh-privacy-gateway",
  "version": "0.1.6",
  "type": "module",
  "description": "Process-wide HTTP redaction gateway for DSH: masks secrets in outgoing model requests and restores placeholders in the replies, for every provider.",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "author": "xbzbing <xbzbing@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbzbing/dsh-privacy-gateway.git"
  },
  "homepage": "https://github.com/xbzbing/dsh-privacy-gateway#readme",
  "bugs": "https://github.com/xbzbing/dsh-privacy-gateway/issues",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./client": "./lib/client.js"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "locale",
    "docs/details",
    "docs/assets",
    "assets",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "node --test \"test/*.test.ts\"",
    "verify": "pnpm typecheck && pnpm test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "redaction",
    "privacy",
    "secrets",
    "undici"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "undici": "8.11.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
