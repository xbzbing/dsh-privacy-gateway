{
  "name": "dsh-privacy-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Process-wide HTTP redaction gateway for DSH: masks secrets in outgoing model requests and restores placeholders in the replies, for every provider.",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "author": "xbzbing <xbzbing@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbzbing/dsh-privacy-gateway.git"
  },
  "homepage": "https://github.com/xbzbing/dsh-privacy-gateway#readme",
  "bugs": "https://github.com/xbzbing/dsh-privacy-gateway/issues",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "locale",
    "assets",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "verify": "pnpm typecheck && pnpm test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "redaction",
    "privacy",
    "secrets",
    "undici"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
